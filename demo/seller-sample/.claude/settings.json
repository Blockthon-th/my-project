{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(node *check.mjs*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/mm/tools/capture.mjs prompt",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/mm/tools/capture.mjs tool",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/mm/tools/capture.mjs stop",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
