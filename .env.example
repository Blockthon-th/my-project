# ─── scripts/deploy.ps1 이 채움 ───
MARKET_PACKAGE_ID=
SUI_NETWORK=testnet

# ─── scripts/setup-wallets.ps1 이 채움 (커밋 금지) ───
SELLER_SUI_PRIVATE_KEY=
BUYER_SUI_PRIVATE_KEY=

# ─── npm run sync 가 채움 ───
MARKET_PACK_ID=
MARKET_CAP_ID=

# ─── 선택 ───
# 기억 출처: memwal | file  (기본: MEMWAL_* 가 있으면 memwal, 없으면 docs/dev-memories.md)
# MEMORY_SOURCE=file

# MemWal (testnet). `npx -y @mysten-incubation/memwal-mcp login` 후
# ~/.memwal/credentials.json 에서 복사
MEMWAL_SERVER_URL=https://relayer-staging.memory.walrus.xyz
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_NAMESPACE=sui-dev

# 팩 설정 (sync 가 팩을 처음 만들 때 사용)
# PACK_NAME=Sui 온보딩 실전 기억
# PACK_FEE_MIST=10000000        # 0.01 SUI
# PACK_TTL_MS=86400000          # 24시간
# AGENT_LABEL=claude-code

# 목록에서 숨길 팩 (쉼표 구분). e2e 테스트 팩은 구독 기간이 5분 미만이라 자동으로 숨겨진다.
# MARKET_HIDDEN_PACKS=0x...,0x...

# Seal 키 서버: independent (기본, 동작 확인됨) | committee
# SEAL_KEY_SERVERS=independent
# SEAL_SESSION_TTL_MIN=5

# gRPC 엔드포인트 덮어쓰기
# SUI_GRPC_URL=https://fullnode.testnet.sui.io:443
